<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot_manipulator">

  <!--
    Lightweight URDF only for MoveIt Setup Assistant.
    No STL visual meshes.
    No STL collision meshes.
    Kinematics are copied from the real robot.urdf.xacro.
  -->

  <material name="dark_gray">
    <color rgba="0.15 0.15 0.15 1.0"/>
  </material>

  <material name="light_gray">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.2 0.8 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.45 0.0 1.0"/>
  </material>

  <xacro:macro name="default_inertial" params="mass">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="0.01" ixy="0.0" ixz="0.0"
        iyy="0.01" iyz="0.0"
        izz="0.01"/>
    </inertial>
  </xacro:macro>

  <!-- ===================== BASE ===================== -->

  <link name="world"/>

  <joint name="world_to_base_fixed" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.16 0.07"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.16 0.07"/>
      </geometry>
    </collision>
    <xacro:default_inertial mass="2.0"/>
  </link>

  <!-- ===================== LINKS ===================== -->

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.08"/>
      </geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.08"/>
      </geometry>
    </collision>
    <xacro:default_inertial mass="1.0"/>
  </link>

  <link name="link_2">
    <visual>
      <origin xyz="0 0.11 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.22"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0.11 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.22"/>
      </geometry>
    </collision>
    <xacro:default_inertial mass="1.0"/>
  </link>

  <link name="link_3">
    <visual>
      <origin xyz="0.035 0.04 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.08 0.08"/>
      </geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0.035 0.04 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.16 0.08 0.08"/>
      </geometry>
    </collision>
    <xacro:default_inertial mass="1.0"/>
  </link>

  <link name="link_4">
    <visual>
      <origin xyz="0 0 0.086" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.172"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.086" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.172"/>
      </geometry>
    </collision>
    <xacro:default_inertial mass="0.8"/>
  </link>

  <link name="link_5">
    <visual>
      <origin xyz="0 0.043 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.086"/>
      </geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0.043 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.086"/>
      </geometry>
    </collision>
    <xacro:default_inertial mass="0.8"/>
  </link>

  <link name="link_6">
    <visual>
      <origin xyz="0 0 0.043" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.0867"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.043" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.0867"/>
      </geometry>
    </collision>
    <xacro:default_inertial mass="0.5"/>
  </link>

  <link name="tool0"/>

  <!-- ===================== ARM JOINTS ===================== -->

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.1038" rpy="0 0 3.1416"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="30" velocity="1.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="-0.04375 -0.0558 0.08" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.7854" upper="1.5708" effort="30" velocity="1.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0.22 -0.04" rpy="0 3.1416 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="30" velocity="1.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.07 0.075 0.06" rpy="0 1.5708 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.1416" upper="3.1416" effort="20" velocity="1.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0 0 0.172" rpy="1.5708 0 -1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0944" upper="2.0944" effort="10" velocity="1.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="joint_6" type="revolute">
    <parent link="link_5"/>
    <child link="link_6"/>
    <origin xyz="0 0.08593 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="30" velocity="1.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="tool0_fixed_joint" type="fixed">
    <parent link="link_6"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.0867" rpy="0 0 0"/>
  </joint>

  <!-- ===================== LIGHT GRIPPER ===================== -->

  <link name="left_finger">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.015 0.06"/>
      </geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.015 0.06"/>
      </geometry>
    </collision>
    <xacro:default_inertial mass="0.1"/>
  </link>

  <link name="right_finger">
    <visual>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.015 0.06"/>
      </geometry>
      <material name="light_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03" rpy="0 0 0"/>
      <geometry>
        <box size="0.015 0.015 0.06"/>
      </geometry>
    </collision>
    <xacro:default_inertial mass="0.1"/>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="link_6"/>
    <child link="left_finger"/>
    <origin xyz="0 0 0.0435" rpy="1.5708 0 1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.025" effort="5" velocity="0.05"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="link_6"/>
    <child link="right_finger"/>
    <origin xyz="0 0 0.0435" rpy="1.5708 0 -1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="0.0" upper="0.025" effort="5" velocity="0.05"/>
    <mimic joint="left_finger_joint" multiplier="1.0" offset="0.0"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

</robot>