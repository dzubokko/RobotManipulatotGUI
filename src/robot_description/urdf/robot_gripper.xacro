<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Захват робота-манипулятора.

    Логика:
    0.000 м — закрыто
    0.025 м — открыто

    Важно:
    Оси движения у ОБОИХ пальцев заданы как 0 0 -1.
    Это нужно потому, что при axis="0 0 1" положительное значение 0.025
    уводило пальцы внутрь друг друга. Инвертируем направление хода у обоих
    пальцев одновременно, чтобы 0.025 раздвигало пальцы наружу.

    mimic убран, потому что gripper_controller уже управляет двумя суставами:
    left_finger_joint и right_finger_joint.
  -->

  <xacro:macro name="finger_link" params="name visual_mesh material">
    <link name="${name}">

      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh
            filename="package://robot_description/meshes/visual/${visual_mesh}"
            scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="${material}"/>
      </visual>

      <collision>
        <origin xyz="0 0 0.03" rpy="0 0 0"/>
        <geometry>
          <box size="0.015 0.015 0.06"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.1"/>
        <inertia
          ixx="0.001" ixy="0.0" ixz="0.0"
          iyy="0.001" iyz="0.0"
          izz="0.001"/>
      </inertial>

    </link>
  </xacro:macro>

  <!-- ===================== FINGER LINKS ===================== -->

  <xacro:finger_link
    name="left_finger"
    visual_mesh="left_finger.STL"
    material="light_gray"/>

  <xacro:finger_link
    name="right_finger"
    visual_mesh="right_finger.STL"
    material="light_gray"/>

  <!-- ===================== LEFT FINGER JOINT ===================== -->

  <joint name="left_finger_joint" type="prismatic">
    <parent link="link_6"/>
    <child link="left_finger"/>

    <origin xyz="0 0 0.0435" rpy="1.5708 0 1.5708"/>

    <!-- Инвертированная ось: 0.025 должно открывать, а не вдавливать внутрь -->
    <axis xyz="0 0 -1"/>

    <limit lower="0.0" upper="0.025" effort="5" velocity="0.05"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

  <!-- ===================== RIGHT FINGER JOINT ===================== -->

  <joint name="right_finger_joint" type="prismatic">
    <parent link="link_6"/>
    <child link="right_finger"/>

    <origin xyz="0 0 0.0435" rpy="1.5708 0 -1.5708"/>

    <!-- Инвертированная ось у второго пальца ТОЖЕ.
         Меняем оба пальца, а не один. -->
    <axis xyz="0 0 -1"/>

    <limit lower="0.0" upper="0.025" effort="5" velocity="0.05"/>
    <dynamics damping="0.0" friction="0.0"/>
  </joint>

</robot>